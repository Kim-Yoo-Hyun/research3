FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONPATH=/source

RUN python -m pip install --no-cache-dir \
    transformers==4.57.0 \
    accelerate==1.5.2 \
    einops==0.8.2 \
    omegaconf==2.3.0 \
    numpy==1.26.4 \
    pillow==12.0.0 \
    rich==14.2.0 \
    qwen-vl-utils==0.0.14 \
    pydantic==2.10.6 \
    numpydantic==1.6.9 \
    pandas==2.3.3 \
    pyarrow==20.0.0 \
    opencv-python-headless==4.11.0.86 \
    av==16.0.1 \
    decord==0.6.0 \
    scipy==1.15.3 \
    torchvision==0.22.1 \
    albumentations==1.4.18 \
    websockets==16.1.1 \
    msgpack==1.1.2

WORKDIR /work
ENTRYPOINT ["python"]
