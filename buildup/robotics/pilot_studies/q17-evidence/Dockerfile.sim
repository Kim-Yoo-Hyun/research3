FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/sim \
    TORCH_CUDA_ARCH_LIST=12.0 \
    MAX_JOBS=4

RUN apt-get update && apt-get install -y --no-install-recommends \
    libvulkan1 libgl1 libglib2.0-0 libgomp1 libx11-6 libxext6 \
    build-essential git ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    numpy==1.26.4 \
    sapien==3.0.0b1 \
    mplib==0.2.1 \
    open3d==0.18.0 \
    gymnasium==0.29.1 \
    toppra==0.6.3 \
    transforms3d==0.4.2 \
    trimesh==4.4.3 \
    imageio==2.34.2 \
    scipy==1.15.3 \
    PyYAML==6.0.2 \
    h5py==3.16.0 \
    zarr==2.18.3 \
    opencv-python-headless==4.11.0.86 \
    pyglet==1.5.31 \
    tqdm==4.67.1

RUN git clone --filter=blob:none --no-checkout https://github.com/NVlabs/curobo.git /opt/curobo \
    && git -C /opt/curobo fetch --depth 1 origin d64c4b005459db10c5dd867d8b30a87d5bda9bdb \
    && git -C /opt/curobo checkout --detach d64c4b005459db10c5dd867d8b30a87d5bda9bdb \
    && printf 'numpy==1.26.4\n' > /tmp/curobo-constraints.txt \
    && python -m pip install --no-cache-dir setuptools==69.5.1 setuptools_scm==8.3.1 wheel==0.45.1 \
    && python -m pip install --no-cache-dir --no-build-isolation \
       --constraint /tmp/curobo-constraints.txt -e /opt/curobo \
    && python -m pip install --no-cache-dir warp-lang==1.12.0

WORKDIR /sim
