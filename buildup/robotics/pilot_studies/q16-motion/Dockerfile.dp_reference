FROM python:3.11-slim-bookworm@sha256:b1add8a6f2aca6bcfcf0b9c9b522352f7ce0d62a3d556a2f2f32511aa0cca250
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SDL_VIDEODRIVER=dummy PYGAME_HIDE_SUPPORT_PROMPT=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libx11-6 libxext6 libsm6 libice6 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.dp.lock /recipe/requirements.dp.lock
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128
RUN pip install --no-cache-dir -r /recipe/requirements.dp.lock && pip check && pip freeze --all > /recipe/installed.dp.lock
RUN groupadd -g 1001 research && useradd -m -u 1001 -g 1001 research
USER 1001:1001
WORKDIR /study
